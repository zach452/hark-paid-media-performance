    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "1.56.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
