SHADOW_REFRESH_TOKEN=

# Apple Search Ads Campaign Management API v5 (fallback while Shadow has no Apple query surface)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ORG_ID=

# Storage
BLOB_READ_WRITE_TOKEN=

# Access
CRON_SECRET=
ACCESS_KEYS=
ADMIN_KEY=
