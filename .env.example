# Copy to .env.local for local work. Set the same names in Vercel project settings.
# Never commit real values.

# Shadow MCP (server-only). Exactly which of these is used depends on the Phase 0 auth spike.
SHADOW_MCP_URL=https://mcp.shadow.co
SHADOW_WORKSPACE=Hark
SHADOW_API_KEY=
SHADOW_OAUTH_CLIENT_ID=
